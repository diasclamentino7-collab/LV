LV_ENVIRONMENT=production
CADDY_DOMAIN=app.lv-wedding.pt
LV_DEBUG=false
LV_SECRET_KEY=generate-a-unique-secret-with-at-least-32-characters
LV_SETUP_TOKEN=generate-a-private-installation-token-with-32-characters
POSTGRES_DB=lv_wedding_planner
POSTGRES_USER=lv_wedding
POSTGRES_PASSWORD=generate-a-long-database-password
LV_DATABASE_URL=postgresql+psycopg://lv_wedding:generate-a-long-database-password@db:5432/lv_wedding_planner
LV_SESSION_HTTPS_ONLY=true
LV_ALLOWED_HOSTS=lv-wedding.pt,app.lv-wedding.pt
LV_LOG_LEVEL=INFO
LV_UPLOADS_DIR=uploads
LV_BACKUPS_DIR=backups
